DATABASE_URL=postgresql+psycopg://third_space:third_space@localhost:5433/third_space
SESSION_SECRET=replace-this-with-a-long-random-value
ADDRESS_ENCRYPTION_KEY=generate-with-Fernet.generate_key
COOKIE_SECURE=false
APP_ENV=development
# Set these explicitly for a production deployment; see DEPLOYMENT.md.
APP_ORIGIN=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# true uses .mock/third_space.db and seeds demo data on first startup.
# false uses DATABASE_URL above. Start with: uvicorn app.main:app --reload --env-file .env
USE_MOCK_DATA=false

# local uses your catalog only; google also discovers venues for opted-in members.
# Mock mode always disables Google API requests.
PLACES_PROVIDER=local
GOOGLE_PLACES_API_KEY=

# Town/postal-code lookup. Mock mode always uses offline sample locations.
# The free Open-Meteo endpoint is for non-commercial development/use.
LOCATION_SEARCH_PROVIDER=open-meteo
# Optional commercial Open-Meteo key; selects their customer endpoint.
OPEN_METEO_API_KEY=
