DATABASE_URL=postgresql+psycopg://third_space:third_space@localhost:5433/third_space
SESSION_SECRET=replace-this-with-a-long-random-value
ADDRESS_ENCRYPTION_KEY=generate-with-Fernet.generate_key
COOKIE_SECURE=false

# true uses .mock/third_space.db and seeds demo data on first startup.
# false uses DATABASE_URL above. Start with: uvicorn app.main:app --reload --env-file .env
USE_MOCK_DATA=false
