APP_ENV=production
USE_MOCK_DATA=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADDRESS_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
COOKIE_SECURE=true
APP_ORIGIN=https://YOUR-APP.up.railway.app
ALLOWED_HOSTS=YOUR-APP.up.railway.app,healthcheck.railway.app
# Railway terminates HTTPS and proxies traffic to this private container.
# Only use * behind that managed proxy; do not expose this container directly.
FORWARDED_ALLOW_IPS=*
PLACES_PROVIDER=local
GOOGLE_PLACES_API_KEY=
# Use local initially, or configure a commercial Open-Meteo subscription for a commercial app.
LOCATION_SEARCH_PROVIDER=local
OPEN_METEO_API_KEY=
